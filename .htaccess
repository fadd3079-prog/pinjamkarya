Options -Indexes
DirectoryIndex index.php index.html

<FilesMatch "(^\.|^README\.md$|\.sql$|\.local\.php$|\.example\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
