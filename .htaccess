Options -Indexes
DirectoryIndex index.php index.html

<FilesMatch "(^\.|\.md$|\.sql$|\.zip$|\.local\.php$|\.example\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
